# =============================================================================
# CareerPilot AI — Backend Environment Configuration Example
# Copy this file to .env and configure values for your deployment environment.
# DO NOT commit real secrets or production credentials to version control.
# =============================================================================

# Server Environment & Port
FLASK_ENV=production
FLASK_PORT=5000
SECRET_KEY=replace_with_a_strong_random_secret_key_minimum_32_characters

# Database (MongoDB connection string)
# Local: mongodb://localhost:27017/careerpilot_ai
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/careerpilot_ai?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/careerpilot_ai

# JWT Authentication
# Secret used to sign JSON Web Tokens (HS256)
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI Integration (Google Gemini)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Cross-Origin Resource Sharing (CORS)
# URL of the frontend client allowed to communicate with the API
FRONTEND_URL=http://localhost:5173

# Background Scheduler & Ingestion (APScheduler)
# Set to 'true' on the primary/worker node; set to 'false' on secondary web workers to avoid duplicate jobs
ENABLE_BACKGROUND_SCHEDULER=true
OPPORTUNITY_INGESTION_HOURS=6
OPPORTUNITY_SEED_ON_STARTUP=true

# Email Notification Delivery (SMTP / TLS)
# If unconfigured, the system safely records digest deliveries in simulation mode without failing
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=alerts@example.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_DEFAULT_SENDER=CareerPilot AI <alerts@careerpilot.ai>

# File Upload Storage
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

#HI HI
